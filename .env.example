# --- Server ---------------------------------------------------------------
PORT=8080
APP_ENV=local
LOG_LEVEL=info

# Required. Guards every management endpoint. Generate with: openssl rand -hex 32
AUTHCELL_ADMIN_TOKEN=change-me-to-a-random-64-char-hex-string-0000000000000000

# Optional. When set, POST /v1/keys/verify also needs "Authorization: Bearer <token>".
AUTHCELL_VERIFY_TOKEN=

# Optional. Comma-separated origins for browser access. Empty disables CORS.
CORS_ORIGINS=
# Optional. Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=

# --- Keys -----------------------------------------------------------------
# Window used for each key's rate_limit (e.g. 1000 per 1m).
RATE_LIMIT_WINDOW=1m
# How long verification logs are kept. 0 keeps them forever.
USAGE_RETENTION_DAYS=90

# --- Database -------------------------------------------------------------
# Either set DATABASE_URL, or the DB_* values below.
# DATABASE_URL=postgres://authcell:secret@localhost:5432/authcell?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=authcell
DB_USERNAME=authcell
DB_PASSWORD=authcell
DB_SCHEMA=public
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
